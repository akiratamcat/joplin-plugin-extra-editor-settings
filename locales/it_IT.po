#, javascript-format
msgid "Follow link: %s"
msgstr "Apri collegamento: %s"

#: src/contentScript/syncIndicatorPanel.ts:35
msgid "Not syncing"
msgstr "Sincronizzazione non in corso"

#: src/contentScript/syncIndicatorPanel.ts:40
msgid "Syncing..."
msgstr "Sincronizzazione in corso..."

#: src/contentScript/syncIndicatorPanel.ts:45
msgid "Failed to sync"
msgstr "Sincronizzazione non riuscita"

#: src/contentScript/wordCountPanel.ts:27
msgid "Words"
msgstr "Parole"

#: src/settings.ts:11
msgid "Extra editor settings"
msgstr "Impostazioni aggiuntive dell'editor"

#: src/settings.ts:12
msgid "Additional settings for Joplin's beta and mobile Markdown editors."
msgstr "Impostazioni aggiuntive per gli editor Markdown beta e mobile di Joplin."

#: src/settings.ts:33
msgid "Show line numbers"
msgstr "Mostra i numeri di riga"

#: src/settings.ts:38
msgid "Enable code folding"
msgstr "Abilita la piegatura del codice"

#: src/settings.ts:43
msgid "Enable autocomplete"
msgstr "Abilita il completamento automatico"

#: src/settings.ts:48
msgid "Highlight the gutter for the active line"
msgstr "Evidenzia il margine della riga attiva"

#: src/settings.ts:49
msgid "Requires \"show line numbers\" to be enabled."
msgstr "Richiede che \"Mostra i numeri di riga\" sia abilitato."

#: src/settings.ts:54
msgid "Highlight active line"
msgstr "Evidenzia la riga attiva"

#: src/settings.ts:59
msgid "Highlight spaces"
msgstr "Evidenzia gli spazi"

#: src/settings.ts:64
msgid "Highlight trailing spaces"
msgstr "Evidenzia gli spazi finali"

#: src/settings.ts:69
msgid "Highlight selection matches"
msgstr "Evidenzia le corrispondenze della selezione"

#: src/settings.ts:74
msgid "Highlight matching brackets"
msgstr "Evidenzia le parentesi corrispondenti"

#: src/settings.ts:84
#, javascript-format
msgid "%s (small)"
msgstr "%s (piccola)"

#: src/settings.ts:90
#, javascript-format
msgid "%s (large)"
msgstr "%s (grande)"

#: src/settings.ts:95
msgid "Editor maximum width"
msgstr "Larghezza massima dell'editor"

#: src/settings.ts:96
msgid "Setting this to a positive number (e.g. 600) centers the editor and prevents it from having a width larger than this size. Set this to \"none\" for the editor to fill the screen."
msgstr "Impostando un numero positivo (ad es. 600) l'editor viene centrato e la sua larghezza non supera questo valore. Imposta \"Nessuna\" perché l'editor occupi tutto lo schermo."

#: src/settings.ts:101
msgid "Show background grid pattern"
msgstr "Mostra una griglia di sfondo"

#: src/settings.ts:106
msgid "Show word count"
msgstr "Mostra il conteggio delle parole"

#: src/settings.ts:112
msgid "Show visual sync indicator"
msgstr "Mostra l'indicatore visivo di sincronizzazione"

#: src/settings.ts:113
msgid "Shows the sync status in the Markdown editor."
msgstr "Mostra lo stato della sincronizzazione nell'editor Markdown."

#: src/settings.ts:117
msgid "With text"
msgstr "Con testo"

#: src/settings.ts:118
msgid "With an icon"
msgstr "Con un'icona"

#: src/settings.ts:126
msgid "Hide Markdown"
msgstr "Nascondi Markdown"

#: src/settings.ts:127
msgid ""
"Hides/replaces certain Markdown characters when the cursor is on a different line.\n"
"\n"
"When set to \"Some\", only some Markup is rendered. When set to \"More\", somewhat more Markup is rendered, though may not be rendered correctly."
msgstr ""
"Nasconde/sostituisce alcuni caratteri Markdown quando il cursore si trova su un'altra riga.\n"
"\n"
"Con \"Alcuni\", viene visualizzata solo una parte del markup. Con \"Di più\", viene visualizzato più markup, ma potrebbe non essere reso correttamente."

#: src/settings.ts:131
msgid "Some"
msgstr "Alcuni"

#: src/settings.ts:133
msgid "More (experimental)"
msgstr "Di più (sperimentale)"

#: src/settings.ts:140
msgid "Show link tooltip"
msgstr "Mostra il suggerimento dei collegamenti"

#: src/settings.ts:141
msgid "Shows tooltips that allow opening links under the cursor"
msgstr "Mostra suggerimenti che consentono di aprire i collegamenti sotto il cursore"

#: src/settings.ts:149
msgid "Text direction"
msgstr "Direzione del testo"

#: src/settings.ts:150
msgid "Overrides the default direction of text in the CodeMirror editor. For most users, this should be set to \"auto\"."
msgstr "Sostituisce la direzione predefinita del testo nell'editor CodeMirror. Per la maggior parte degli utenti dovrebbe essere impostata su \"Automatica\"."

#: src/settings.ts:153
msgid "Auto"
msgstr "Automatica"

#: src/settings.ts:154
msgid "Left-to-right"
msgstr "Da sinistra a destra"

#: src/settings.ts:155
msgid "Right-to-left"
msgstr "Da destra a sinistra"

#: src/settings.ts:83
msgctxt "editor maximum width"
msgid "None"
msgstr "Nessuna"

#: src/settings.ts:116
msgctxt "sync indicator"
msgid "No"
msgstr "No"

#: src/settings.ts:130
msgctxt "hide markdown"
msgid "None"
msgstr "Nessuno"

