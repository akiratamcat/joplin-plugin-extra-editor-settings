#, javascript-format
msgid "Follow link: %s"
msgstr "リンクを開く: %s"

#: src/contentScript/syncIndicatorPanel.ts:35
msgid "Not syncing"
msgstr "同期していません"

#: src/contentScript/syncIndicatorPanel.ts:40
msgid "Syncing..."
msgstr "同期中..."

#: src/contentScript/syncIndicatorPanel.ts:45
msgid "Failed to sync"
msgstr "同期に失敗しました"

#: src/contentScript/wordCountPanel.ts:27
msgid "Words"
msgstr "単語数"

#: src/settings.ts:11
msgid "Extra editor settings"
msgstr "エディターの追加設定"

#: src/settings.ts:12
msgid "Additional settings for Joplin's beta and mobile Markdown editors."
msgstr "Joplin のベータ版およびモバイル版 Markdown エディター向けの追加設定です。"

#: src/settings.ts:33
msgid "Show line numbers"
msgstr "行番号を表示"

#: src/settings.ts:38
msgid "Enable code folding"
msgstr "コードの折りたたみを有効にする"

#: src/settings.ts:43
msgid "Enable autocomplete"
msgstr "オートコンプリートを有効にする"

#: src/settings.ts:48
msgid "Highlight the gutter for the active line"
msgstr "アクティブな行のガター（行番号欄）を強調表示"

#: src/settings.ts:49
msgid "Requires \"show line numbers\" to be enabled."
msgstr "「行番号を表示」を有効にする必要があります。"

#: src/settings.ts:54
msgid "Highlight active line"
msgstr "アクティブな行を強調表示"

#: src/settings.ts:59
msgid "Highlight spaces"
msgstr "スペースを強調表示"

#: src/settings.ts:64
msgid "Highlight trailing spaces"
msgstr "行末のスペースを強調表示"

#: src/settings.ts:69
msgid "Highlight selection matches"
msgstr "選択範囲と一致する箇所を強調表示"

#: src/settings.ts:74
msgid "Highlight matching brackets"
msgstr "対応する括弧を強調表示"

#: src/settings.ts:84
#, javascript-format
msgid "%s (small)"
msgstr "%s（小）"

#: src/settings.ts:90
#, javascript-format
msgid "%s (large)"
msgstr "%s（大）"

#: src/settings.ts:95
msgid "Editor maximum width"
msgstr "エディターの最大幅"

#: src/settings.ts:96
msgid "Setting this to a positive number (e.g. 600) centers the editor and prevents it from having a width larger than this size. Set this to \"none\" for the editor to fill the screen."
msgstr "正の数（例: 600）を設定すると、エディターが中央に配置され、幅がこのサイズを超えないようになります。エディターを画面いっぱいに表示するには「なし」に設定してください。"

#: src/settings.ts:101
msgid "Show background grid pattern"
msgstr "背景にグリッド模様を表示"

#: src/settings.ts:106
msgid "Show word count"
msgstr "単語数を表示"

#: src/settings.ts:112
msgid "Show visual sync indicator"
msgstr "同期状態を表示"

#: src/settings.ts:113
msgid "Shows the sync status in the Markdown editor."
msgstr "Markdown エディター内に同期状態を表示します。"

#: src/settings.ts:117
msgid "With text"
msgstr "テキストで表示"

#: src/settings.ts:118
msgid "With an icon"
msgstr "アイコンで表示"

#: src/settings.ts:126
msgid "Hide Markdown"
msgstr "Markdown 記号を隠す"

#: src/settings.ts:127
msgid ""
"Hides/replaces certain Markdown characters when the cursor is on a different line.\n"
"\n"
"When set to \"Some\", only some Markup is rendered. When set to \"More\", somewhat more Markup is rendered, though may not be rendered correctly."
msgstr ""
"カーソルが別の行にあるとき、特定の Markdown 記号を非表示にしたり置き換えたりします。\n"
"\n"
"「一部」に設定すると、一部のマークアップのみがレンダリングされます。「多め」に設定すると、より多くのマークアップがレンダリングされますが、正しく表示されない場合があります。"

#: src/settings.ts:131
msgid "Some"
msgstr "一部"

#: src/settings.ts:133
msgid "More (experimental)"
msgstr "多め（実験的）"

#: src/settings.ts:140
msgid "Show link tooltip"
msgstr "リンクのツールチップを表示"

#: src/settings.ts:141
msgid "Shows tooltips that allow opening links under the cursor"
msgstr "カーソル位置のリンクを開くためのツールチップを表示します"

#: src/settings.ts:149
msgid "Text direction"
msgstr "テキストの方向"

#: src/settings.ts:150
msgid "Overrides the default direction of text in the CodeMirror editor. For most users, this should be set to \"auto\"."
msgstr "CodeMirror エディターでのテキストの既定の方向を上書きします。ほとんどのユーザーは「自動」のままで問題ありません。"

#: src/settings.ts:153
msgid "Auto"
msgstr "自動"

#: src/settings.ts:154
msgid "Left-to-right"
msgstr "左から右"

#: src/settings.ts:155
msgid "Right-to-left"
msgstr "右から左"

#: src/settings.ts:83
msgctxt "editor maximum width"
msgid "None"
msgstr "なし"

#: src/settings.ts:116
msgctxt "sync indicator"
msgid "No"
msgstr "表示しない"

#: src/settings.ts:130
msgctxt "hide markdown"
msgid "None"
msgstr "なし"

