msgid "Follow link: %s"
msgstr "Prati vezu: %s"

#: src/contentScript/syncIndicatorPanel.ts:35
msgid "Not syncing"
msgstr "Ne sinkronizira se"

#: src/contentScript/syncIndicatorPanel.ts:40
msgid "Syncing..."
msgstr "Sinkronizacija je u tijeku …"

#: src/contentScript/syncIndicatorPanel.ts:45
msgid "Failed to sync"
msgstr "Sinkronizacija nije uspjela"

#: src/contentScript/wordCountPanel.ts:27
msgid "Words"
msgstr "Riječi"

#: src/settings.ts:11
msgid "Extra editor settings"
msgstr "Dodatne postavke uređivača"

#: src/settings.ts:12
msgid "Additional settings for Joplin's beta and mobile Markdown editors."
msgstr "Dodatne postavke za Joplin beta i mobilne Markdown uređivače."

#: src/settings.ts:33
msgid "Show line numbers"
msgstr "Prikaži brojeve redaka"

#: src/settings.ts:38
msgid "Enable code folding"
msgstr "Uključi preklapanje koda"

#: src/settings.ts:43
msgid "Enable autocomplete"
msgstr "Uključi automatsko dovršavanje"

#: src/settings.ts:48
msgid "Highlight the gutter for the active line"
msgstr "Istakni margine aktivnog retka"

#: src/settings.ts:49
msgid "Requires \"show line numbers\" to be enabled."
msgstr "Zahtijeva da je postavka „Prikaži brojeve redaka” uključena."

#: src/settings.ts:54
msgid "Highlight active line"
msgstr "Istakni aktivni redak"

#: src/settings.ts:59
msgid "Highlight spaces"
msgstr "Istakni razmake"

#: src/settings.ts:64
msgid "Highlight trailing spaces"
msgstr "Istakni završne razmake"

#: src/settings.ts:69
msgid "Highlight selection matches"
msgstr "Istakni podudaranja odabira"

#: src/settings.ts:74
msgid "Highlight matching brackets"
msgstr "Istakni poklapajuće zagrade"

#: src/settings.ts:84
#, javascript-format
msgid "%s (small)"
msgstr "%s (mala)"

#: src/settings.ts:90
#, javascript-format
msgid "%s (large)"
msgstr "%s (velika)"

#: src/settings.ts:95
msgid "Editor maximum width"
msgstr "Maksimalna širina uređivača"

#: src/settings.ts:96
msgid "Setting this to a positive number (e.g. 600) centers the editor and prevents it from having a width larger than this size. Set this to \"none\" for the editor to fill the screen."
msgstr "Postavljanje pozitivnog broja (npr. 600) centrirat će uređivač i spriječiti da njegova širina bude veća od ove vrijednosti. Postavi na „bez” da uređivač popuni ekran."

#: src/settings.ts:101
msgid "Show background grid pattern"
msgstr "Prikaži uzorak mreže pozadine"

#: src/settings.ts:106
msgid "Show word count"
msgstr "Prikaži broj riječi"

#: src/settings.ts:112
msgid "Show visual sync indicator"
msgstr "Prikaži vizualni indikator sinkronizacije"

#: src/settings.ts:113
msgid "Shows the sync status in the Markdown editor."
msgstr "Prikazuje stanje sinkronizacije u Markdown uređivaču."

#: src/settings.ts:117
msgid "With text"
msgstr "S tekstom"

#: src/settings.ts:118
msgid "With an icon"
msgstr "S ikonom"

#: src/settings.ts:126
msgid "Hide Markdown"
msgstr "Sakrij Markdown"

#: src/settings.ts:127
msgid ""
"Hides/replaces certain Markdown characters when the cursor is on a different line.\n"
"\n"
"When set to \"Some\", only some Markup is rendered. When set to \"More\", somewhat more Markup is rendered, though may not be rendered correctly."
msgstr ""
"Skriva/zamijenjuje određene Markdown znakove kada se kursor nalazi na jednom drugom retku.\n"
"\n"
"Kada je postavljeno na „Neki”, prikazuje se samo dio markup-a. Kada je postavljeno na „Više”, prikazuje se nešto više markup-a, ali možda neće ispravno prikazati"

#: src/settings.ts:131
msgid "Some"
msgstr "Neki"

#: src/settings.ts:133
msgid "More (experimental)"
msgstr "Više (eksperimentalno)"

#: src/settings.ts:140
msgid "Show link tooltip"
msgstr "Prikaži opis poveznice"

#: src/settings.ts:141
msgid "Shows tooltips that allow opening links under the cursor"
msgstr "Prikazuje opise koji omogućuju otvaranje poveznica ispod kursora"

#: src/settings.ts:149
msgid "Text direction"
msgstr "Smjer teksta"

#: src/settings.ts:150
msgid "Overrides the default direction of text in the CodeMirror editor. For most users, this should be set to \"auto\"."
msgstr "Prekida zadani smjer teksta u CodeMirror uređivaču. Za većinu korisnika, ovo bi trebalo biti postavljeno na „Automatski”."

#: src/settings.ts:153
msgid "Auto"
msgstr "Automatski"

#: src/settings.ts:154
msgid "Left-to-right"
msgstr "S lijeva na desno"

#: src/settings.ts:155
msgid "Right-to-left"
msgstr "S desna na lijevo"

#: src/settings.ts:83
msgctxt "editor maximum width"
msgid "None"
msgstr "Bez"

#: src/settings.ts:116
msgctxt "sync indicator"
msgid "No"
msgstr "Ne"

#: src/settings.ts:130
msgctxt "hide markdown"
msgid "None"
msgstr "Bez"

