#: src/settings.ts:11
msgid "Extra editor settings"
msgstr "Ajustes adicionales del editor"

#: src/settings.ts:12
msgid "Additional settings for Joplin's beta and mobile Markdown editors."
msgstr "Ajustes adicionales para los editores Markdown beta y móvil de Joplin."

#: src/settings.ts:33
msgid "Show line numbers"
msgstr "Mostrar números de línea"

#: src/settings.ts:38
msgid "Enable code folding"
msgstr "Activar plegado de código"

#: src/settings.ts:43
msgid "Enable autocomplete"
msgstr "Activar autocompletado"

#: src/settings.ts:48
msgid "Highlight the gutter for the active line"
msgstr "Resaltar el margen de la línea activa"

#: src/settings.ts:49
msgid "Requires \"show line numbers\" to be enabled."
msgstr "Requiere que «Mostrar números de línea» esté activado."

#: src/settings.ts:54
msgid "Highlight active line"
msgstr "Resaltar la línea activa"

#: src/settings.ts:59
msgid "Highlight spaces"
msgstr "Resaltar espacios"

#: src/settings.ts:64
msgid "Highlight trailing spaces"
msgstr "Resaltar espacios al final de línea"

#: src/settings.ts:69
msgid "Highlight selection matches"
msgstr "Resaltar coincidencias de la selección"

#: src/settings.ts:74
msgid "Highlight matching brackets"
msgstr "Resaltar corchetes coincidentes"

#: src/settings.ts:84
#, javascript-format
msgid "%s (small)"
msgstr "%s (pequeño)"

#: src/settings.ts:90
#, javascript-format
msgid "%s (large)"
msgstr "%s (grande)"

#: src/settings.ts:95
msgid "Editor maximum width"
msgstr "Ancho máximo del editor"

#: src/settings.ts:96
msgid "Setting this to a positive number (e.g. 600) centers the editor and prevents it from having a width larger than this size. Set this to \"none\" for the editor to fill the screen."
msgstr "Si se establece un número positivo (p. ej., 600), el editor se centra y su ancho no supera ese valor. Establécelo en «Ninguno» para que el editor ocupe toda la pantalla."

#: src/settings.ts:101
msgid "Show background grid pattern"
msgstr "Mostrar cuadrícula de fondo"

#: src/settings.ts:106
msgid "Show word count"
msgstr "Mostrar recuento de palabras"

#: src/settings.ts:112
msgid "Show visual sync indicator"
msgstr "Mostrar indicador visual de sincronización"

#: src/settings.ts:113
msgid "Shows the sync status in the Markdown editor."
msgstr "Muestra el estado de sincronización en el editor Markdown."

#: src/settings.ts:117
msgid "With text"
msgstr "Con texto"

#: src/settings.ts:118
msgid "With an icon"
msgstr "Con un icono"

#: src/settings.ts:126
msgid "Hide Markdown"
msgstr "Ocultar Markdown"

#: src/settings.ts:127
msgid ""
"Hides/replaces certain Markdown characters when the cursor is on a different line.\n"
"\n"
"When set to \"Some\", only some Markup is rendered. When set to \"More\", somewhat more Markup is rendered, though may not be rendered correctly."
msgstr ""
"Oculta o reemplaza ciertos caracteres Markdown cuando el cursor está en otra línea.\n"
"\n"
"Con «Algunos», solo se representa parte del marcado. Con «Más», se representa algo más de marcado, aunque puede que no se muestre correctamente."

#: src/settings.ts:131
msgid "Some"
msgstr "Algunos"

#: src/settings.ts:133
msgid "More (experimental)"
msgstr "Más (experimental)"

#: src/settings.ts:140
msgid "Show link tooltip"
msgstr "Mostrar información sobre enlaces"

#: src/settings.ts:141
msgid "Shows tooltips that allow opening links under the cursor"
msgstr "Muestra información emergente que permite abrir los enlaces bajo el cursor"

#: src/settings.ts:149
msgid "Text direction"
msgstr "Dirección del texto"

#: src/settings.ts:150
msgid "Overrides the default direction of text in the CodeMirror editor. For most users, this should be set to \"auto\"."
msgstr "Anula la dirección predeterminada del texto en el editor CodeMirror. Para la mayoría de los usuarios, debería estar en «Automática»."

#: src/settings.ts:153
msgid "Auto"
msgstr "Automática"

#: src/settings.ts:154
msgid "Left-to-right"
msgstr "De izquierda a derecha"

#: src/settings.ts:155
msgid "Right-to-left"
msgstr "De derecha a izquierda"

#: src/settings.ts:83
msgctxt "editor maximum width"
msgid "None"
msgstr "Ninguno"

#: src/settings.ts:116
msgctxt "sync indicator"
msgid "No"
msgstr "No"

#: src/settings.ts:130
msgctxt "hide markdown"
msgid "None"
msgstr "Ninguno"

